[Unit]
Description=Immich Server
Requires=immich-network.service immich-database.service immich-redis.service immich-machine-learning.service
After=immich-network.service immich-database.service immich-redis.service immich-machine-learning.service

[Container]
Image=ghcr.io/immich-app/immich-server:v3
ContainerName=immich_server
Network=immich.network
NetworkAlias=immich
PublishPort=2283:2283
Secret=immich_db_password,type=env,target=DB_PASSWORD
Environment=TZ=Asia/Jakarta
Environment=DB_HOSTNAME=immich-database
Environment=DB_USERNAME=postgres
Environment=DB_DATABASE_NAME=immich
Environment=REDIS_HOSTNAME=immich-redis
Environment=IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003
Volume=/var/mnt/data/immich/library:/data:Z
Volume=/etc/localtime:/etc/localtime:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
